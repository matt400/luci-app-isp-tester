#!/usr/bin/ucode
/*
 * luci-app-isp-tester: writes the IGMP querier of the IPTV VLAN into a
 * system hotplug script (Settings -> IPTV -> IGMP querier), run by the init
 * script on every start, so also after "Save & Apply".
 *
 * The script is the system's, not the package's: it is not in the package's
 * file list, so it stays when the package is removed, and it is listed in
 * /etc/sysupgrade.conf, so it stays over a firmware upgrade. The collector
 * sets nothing itself; it only shows whether the bridge matches.
 *
 *   mode unmanaged  the script is left alone (written or not, by hand or not)
 *   mode off        the script stays, switched off (MODE='off'): the ISP asks
 *                   alone; the router's querier is switched off now
 *   mode backup     per-VLAN snooping, the router's querier in the IPTV VLAN
 *                   (asks when the ISP does not), the port towards the ISP a
 *                   permanent multicast router port, optionally no snooping
 *                   in the other VLANs
 *   mode router     as backup, and the ISP's general queries arriving on the
 *                   port towards the ISP are dropped (nft table
 *                   "bridge isp_tester"): only the router asks. Its own
 *                   queries are not sent out of that port either: towards
 *                   the ISP go only the decoders' reports, as before
 *
 * The file is rewritten only when its content changes (no flash writes on
 * every boot), then run once at once. A script of the same name that was not
 * written by this package (the user's own) is kept as
 * /etc/isp-tester/99-iptv-querier.orig before it is replaced.
 * The outcome goes to VARDIR/querier-script.json for the settings page and
 * the collector.
 *
 * Usage: querier-gen.uc [--force]
 */
'use strict';

import * as fs from 'fs';
import { VARDIR, SYSNET, BRIDGE, valid_dev } from './lib/common.uc';
import { rd, base, is_uplink, bridge_json } from './lib/sysinfo.uc';
import { load_config } from './lib/config.uc';

const SCRIPT = getenv('ISP_TESTER_QSCRIPT') || '/etc/hotplug.d/iface/99-iptv-querier';
const SYSUP = getenv('ISP_TESTER_SYSUPGRADE') || '/etc/sysupgrade.conf';
const ORIG = getenv('ISP_TESTER_QORIG') || '/etc/isp-tester/99-iptv-querier.orig';
const MARK = '# generated by luci-app-isp-tester';
const STATUS = `${VARDIR}/querier-script.json`;

let force = index(ARGV, '--force') >= 0;
let cfg = load_config();
let Q = cfg.querier;
let st = { mode: Q.mode, path: SCRIPT, ts: time(), err: null, written: false, applied: false, backup: null,
	sysupgrade: false, br: null, vlan: cfg.iptv.vlan || null, up: null };

function finish() {
	fs.mkdir(VARDIR);
	/* what the file holds now, also for "unmanaged" */
	let cur = fs.readfile(SCRIPT);
	st.exists = cur != null;
	st.ours = cur != null && index(cur, MARK) >= 0;
	let m = cur ? match(cur, /\nMODE='([a-z]+)'/) : null;
	st.file_mode = m ? m[1] : null;
	st.sysupgrade = index(split(fs.readfile(SYSUP) ?? '', '\n'), SCRIPT) >= 0;
	fs.writefile(STATUS, sprintf('%J', st));
	exit(st.err ? 1 : 0);
}

function sh(cmd) {
	let f = fs.popen(`${cmd} 2>&1`, 'r');
	if (!f) return { out: '', code: -1 };
	let out = f.read('all') ?? '';
	return { out: trim(out), code: f.close() };
}

if (Q.mode == 'unmanaged') finish();

/* ---- the bridge, the VLAN and the port towards the ISP, as the collector finds them */
let vid = cfg.iptv.vlan;
if (!vid) { st.err = 'no_vlan'; finish(); }
if (!BRIDGE) { st.err = 'no_bridge_tool'; finish(); }

let ports = [];
for (let e in (bridge_json(`vlan show vid ${vid}`) ?? []))
	for (let v in (e?.vlans ?? [])) {
		let lo = int(v.vid ?? v.vlan), hi = int(v.vlanEnd ?? lo);
		if (vid >= lo && vid <= hi && valid_dev(e.ifname)) push(ports, e.ifname);
	}
let br = cfg.iptv.bridge || null;
if (!br)
	for (let p in ports) {
		let m = base(fs.readlink(`${SYSNET}/${p}/master`));
		if (valid_dev(m)) { br = m; break; }
	}
ports = filter(ports, (p) => p != br);
let up = cfg.iptv.upstream || filter(ports, is_uplink)[0] || filter(ports, (p) => match(p, /^wan/))[0] || null;
st.br = br; st.up = up;
/* nothing found (bridge not up yet): the script that is there stays */
if (!br || !valid_dev(br)) { st.err = 'no_bridge'; finish(); }
if (!up || !valid_dev(up)) { st.err = 'no_upstream'; finish(); }

/* the other VLANs of the bridge, ranges with the IPTV VLAN cut out */
let others = [];
if (Q.others_off)
	for (let e in (bridge_json(`vlan global show dev ${br}`) ?? []))
		for (let v in (e?.vlans ?? [])) {
			if (e.ifname != br) continue;
			let lo = int(v.vlan), hi = int(v.vlanEnd ?? v.vlan), parts = [];
			if (vid >= lo && vid <= hi) {
				if (lo < vid) push(parts, [ lo, vid - 1 ]);
				if (vid < hi) push(parts, [ vid + 1, hi ]);
			}
			else push(parts, [ lo, hi ]);
			for (let p in parts) push(others, (p[0] == p[1]) ? `${p[0]}` : `${p[0]}-${p[1]}`);
		}

/* the ISP's frames come untagged when the VLAN is the port's PVID */
let untagged = false;
for (let e in (bridge_json(`vlan show dev ${up}`) ?? []))
	for (let v in (e?.vlans ?? []))
		if (int(v.vlan) == vid && index(v.flags ?? [], 'PVID') >= 0) untagged = true;

/* ---- the script. Shell variables are written $X, never ${X}: that would be
 * this template's own interpolation */
let rules = `		iifname "$UP" ether type 8021q vlan id $VID @ll,216,8 2 @ll,272,32 0xe0000001 counter drop comment "isp-tester-q $UP/$VID"\n`;
if (untagged)
	rules += `		iifname "$UP" ether type ip @ll,184,8 2 @ll,240,32 0xe0000001 counter drop comment "isp-tester-q $UP/$VID/untagged"\n`;
/* the router's own queries are flooded to every port of the VLAN, also
 * towards the ISP: kept at home. The bridge sends them per port (output
 * hook) or through its own transmit path (output, then postrouting): both */
let own = (hook) => {
	let r = `		oifname "$UP" ether type 8021q vlan id $VID @ll,216,8 2 @ll,272,32 0xe0000001 counter drop comment "isp-tester-o $UP/$VID/${hook}"\n`;
	if (untagged)
		r += `		oifname "$UP" ether type ip @ll,184,8 2 @ll,240,32 0xe0000001 counter drop comment "isp-tester-o $UP/$VID/${hook}/untagged"\n`;
	return r;
};

let text = `#!/bin/sh
${MARK} (Settings -> IPTV -> IGMP querier).
# Not part of the package: it stays when luci-app-isp-tester is removed, and
# it is listed in /etc/sysupgrade.conf. While the package manages it, change
# it in the settings: an edit here is replaced at the next start.
#
# Who sends the IGMP queries on the IPTV VLAN, so the decoders keep their channels:
#   MODE='off'     the ISP alone - this script does nothing
#   MODE='backup'  the ISP, and the router when the ISP stops (it waits 255 s)
#   MODE='router'  only the router; the ISP's queries on $UP are dropped,
#                  and the router's own are not sent to the ISP
#                  (needs kmod-nft-bridge)
MODE='${Q.mode}'
BR='${br}'
VID='${vid}'
UP='${up}'
VER='${Q.igmp_version}'
# VLANs of $BR without IGMP snooping (they have no querier); '' = left as they are
OTHERS='${join(' ', others)}'

[ "$MODE" = backup ] || [ "$MODE" = router ] || exit 0
[ "$ACTION" = ifup ] || [ "$ACTION" = ifupdate ] || [ "$1" = apply ] || exit 0
[ -d "/sys/class/net/$BR" ] || exit 0

ip link set dev "$BR" type bridge mcast_snooping 1 mcast_vlan_snooping 1
bridge vlan global set vid "$VID" dev "$BR" mcast_snooping 1 mcast_querier 1 mcast_igmp_version "$VER"
bridge vlan set vid "$VID" dev "$UP" mcast_router 2
for v in $OTHERS; do
	bridge vlan global set vid "$v" dev "$BR" mcast_snooping 0
done

if [ "$MODE" = router ]; then
	# set once (every interface going up runs this): kept, so its counter goes on
	if [ "$1" = apply ] || ! nft list table bridge isp_tester >/dev/null 2>&1; then
		nft -f - <<EOF || logger -t iptv-querier "cannot set the filter of the ISP's IGMP queries (kmod-nft-bridge installed?)"
table bridge isp_tester
delete table bridge isp_tester
table bridge isp_tester {
	chain isp_queries {
		type filter hook prerouting priority -300; policy accept;
${rules}	}
	chain own_queries_out {
		type filter hook output priority -300; policy accept;
${own('out')}	}
	chain own_queries_post {
		type filter hook postrouting priority -300; policy accept;
${own('post')}	}
}
EOF
	fi
else
	nft delete table bridge isp_tester 2>/dev/null
fi
[ "$1" = apply ] && logger -t iptv-querier "IGMP querier of VLAN $VID on $BR: $MODE"
exit 0
`;

/* ---- write (only a change), keep the user's own script first */
let cur = fs.readfile(SCRIPT);
let changed = cur != text;
if (changed) {
	if (cur != null && index(cur, MARK) < 0 && !fs.stat(ORIG)) {
		fs.mkdir(replace(ORIG, /\/[^\/]*$/, ''));
		if (fs.writefile(ORIG, cur) == null) { st.err = 'backup_failed'; finish(); }
		st.backup = ORIG;
	}
	fs.mkdir(replace(SCRIPT, /\/[^\/]*$/, ''));
	if (fs.writefile(`${SCRIPT}.tmp`, text) == null || !fs.rename(`${SCRIPT}.tmp`, SCRIPT)) { st.err = 'write_failed'; finish(); }
	st.written = true;
}

/* ---- kept over a firmware upgrade */
let su = fs.readfile(SYSUP) ?? '';
if (index(split(su, '\n'), SCRIPT) < 0)
	fs.writefile(SYSUP, su + ((su == '' || substr(su, -1) == '\n') ? '' : '\n') + SCRIPT + '\n');

/* ---- in effect now, not at the next reboot. Also when the filter should be
 * there and is not (kmod-nft-bridge installed after the setting was saved):
 * the script sets it only when an interface comes up */
let nft_missing = Q.mode == 'router' && sh('nft list table bridge isp_tester').code != 0;
if (changed || force || nft_missing) {
	if (Q.mode == 'off') {
		/* the ISP alone from now on: the router's querier and the filter go */
		sh(`${BRIDGE} vlan global set vid ${vid} dev ${br} mcast_querier 0`);
		sh('nft delete table bridge isp_tester');
	}
	else {
		let r = sh(`sh ${SCRIPT} apply`);
		if (r.code != 0) st.err = substr(split(r.out, '\n')[0] ?? '', 0, 160) || 'apply_failed';
	}
	st.applied = true;
}
finish();
