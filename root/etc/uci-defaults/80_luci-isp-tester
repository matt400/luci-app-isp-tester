#!/bin/sh
# sections added in later versions (upgrades keep the old config file)
uci -q get isp_tester.system >/dev/null || uci -q set isp_tester.system=system
uci -q get isp_tester.push >/dev/null || {
	uci -q set isp_tester.push=push
	uci -q set isp_tester.push.enabled=0
	uci -q set isp_tester.push.dir=isp-tester
	uci -q set isp_tester.push.interval_h=24
}
uci -q get isp_tester.peer >/dev/null || {
	uci -q set isp_tester.peer=peer
	uci -q set isp_tester.peer.role=off
}
uci -q get isp_tester.dns >/dev/null || uci -q set isp_tester.dns=dns
uci -q get isp_tester.notify >/dev/null || {
	uci -q set isp_tester.notify=notify
	uci -q set isp_tester.notify.enabled=0
}
# removed features: Wi-Fi clients, link hogs, SoC temperature, USB archive
uci -q delete isp_tester.wifi
while uci -q get 'isp_tester.@station[0]' >/dev/null; do uci -q delete 'isp_tester.@station[0]'; done
uci -q delete isp_tester.wan.hogs
uci -q delete isp_tester.wan.hogs_cooldown
uci -q delete isp_tester.system.temp_warn
uci -q delete isp_tester.general.archive_days
# options of the old sampled picture quality scan (now continuous)
uci -q delete isp_tester.iptv.q_window
uci -q delete isp_tester.iptv.q_interval
uci -q commit isp_tester

# busybox ntpd tells hotplug only when its state changes: restart it once,
# so the tester learns the current state (it re-syncs within seconds)
[ -f /var/run/isp-tester/ntp.last ] || {
	/etc/init.d/sysntpd enabled 2>/dev/null && /etc/init.d/sysntpd restart >/dev/null 2>&1
}

rm -f /tmp/luci-indexcache* /tmp/luci-modulecache/* 2>/dev/null
/etc/init.d/rpcd reload
/etc/init.d/isp_tester enable
# restart, not start: on an upgrade the old collector is still running and
# procd would keep it (same command line), so the new code would not load
/etc/init.d/isp_tester restart
exit 0
