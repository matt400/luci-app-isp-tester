#	option label 'Phone'

# two routers, one timeline: a second router (e.g. an access point with a
# decoder behind it) sends its events to the main router over UDP, signed
# with the shared key (HMAC-SHA256)
config peer 'peer'
	# off | send (second router) | receive (main router)
	option role 'off'
	# send: IPv4 address of the main router
	option host ''
	option port '51477'
	# the same secret on both routers, at least 8 characters
	option key ''

config notify 'notify'
	option enabled '0'
	# ntfy | telegram | webhook
	option service 'ntfy'
	# ntfy: topic URL (https://ntfy.sh/your-secret-topic); webhook: URL that gets a JSON POST
	option url ''
	# telegram: bot token and chat id
	option token ''
	option chat_id ''
	# err = faults only (plus recoveries), warn = also warnings
	option min_level 'err'
	# at most one message per this many seconds; events in between are batched
	option cooldown '300'
	# en | pl
	option lang 'en'

