
config general 'general'
	option enabled '1'
	# sampling interval in seconds
	option interval '10'
	# CSV rows kept in /tmp (8640 x 10 s = 24 h)
	option max_samples '8640'
	option max_events '1000'
	# points kept for the charts (360 x 10 s = 1 h)
	option history '360'
	# an area stays yellow this long after a warning/error event (s)
	option warn_window '900'
	# at most one "errors"/"drops" event per device per this many seconds
	option err_cooldown '60'
	# drops per interval needed to log a "drops" event
	option drop_warn '50'
	# keep timeline, history and CSV in this folder (e.g. a USB stick, /mnt/sda1)
	# instead of RAM, so they survive a reboot. Avoid the internal flash.
	option data_dir ''
	# turn messages of other services in the system log (pppd, udhcpc,
	# igmpproxy, kernel, dnsmasq) into timeline events
	option logread '1'

config wan 'wan'
	option enabled '1'
	# Ping is measured by collectd: luci-app-statistics with the Ping plugin
	# (add the ISP gateway and 1-2 far hosts) and, for live values, UnixSock.
	# logical interface used to find the WAN device and gateway
	option interface 'wan'
	# which collectd ping host is the ISP gateway; empty = gateway from netifd
	option gateway ''
	# packet loss % (per collectd interval) for yellow / red
	option loss_warn '1'
	option loss_fail '50'
	# average RTT (ms) for yellow, 0 = off
	option rtt_warn '80'
	# jitter (ms, collectd ping_stddev) for yellow, 0 = off
	option jitter_warn '0'

config iptv 'iptv'
	option enabled '1'
	# IPTV VLAN number (e.g. 236). Enough when the VLAN is only bridged to the
	# decoders: bitrate from the bridge's per-VLAN counters, channels from the
	# bridge's multicast table, ports detected. Empty = use 'device' below.
	option vlan ''
	# VLAN mode: port towards the ISP; empty = detected (e.g. eth1)
	option upstream ''
	# without vlan: device that carries ONLY IPTV traffic, e.g. eth1.236 or the
	# decoder's port
	option device ''
	# rx = traffic arriving on the device, tx = traffic leaving it (decoder port)
	option direction 'rx'
	# optional bridge to show IGMP snooping/querier state of
	option bridge ''
	# below this the stream is considered stopped
	option min_kbps '500'
	# IPTV bitrate is sampled on its own timer this often (s); 0 = only once per
	# main interval (short freezes are then averaged away)
	option sample_interval '1'
	# bitrate must stay below min_kbps this long (s) to log a freeze
	option stall_after '2'
	# a stall longer than this is treated as "stream ended" (decoder off)
	option idle_after '60'
	# a stop while no channel is subscribed (IGMP) for this long (s) is logged as
	# "decoder switched off" (info), not as a fault; 0 = always a fault
	option off_after '15'
	# warn when bitrate falls below this % of its running average, 0 = off
	option dip_pct '40'
	# watch IGMP group membership and the multicast proxy (igmpproxy, mcproxy)
	option igmp '1'
	# interface the proxy joins the groups on (its upstream); empty = the IPTV
	# device when measuring incoming traffic
	option igmp_device ''
	# picture quality: count lost packets (MPEG-TS continuity errors) in short
	# captures while the stream plays. Needs tcpdump-mini. The channel being
	# watched is found automatically; nothing runs while the decoder is off.
	option quality '0'
	# length of one capture (s) and time between captures (s); after an error
	# the next captures run back to back for a while
	option q_window '5'
	option q_interval '60'
	# lost-packet gaps per capture for a warning / a fault
	option q_warn '1'
	option q_fail '30'
	# also warn when the stream pauses this long (ms) inside a capture, 0 = off
	option q_gap '500'
	# channel names: when a decoder joins a channel whose name is not known
	# yet, read it once from the stream (DVB SDT table, a 3 s capture of just
	# that channel). Needs tcpdump-mini and 'igmp'. Names can also be set by
	# hand in 'channel' sections, which win over the stream.
	option names '1'

# router load, read from /proc only to explain problems (for graphs use
# Status -> Realtime Graphs or luci-app-statistics)
config system 'system'
	option enabled '1'
	# busiest CPU core (%) for two intervals in a row = router overloaded, 0 = off
	option cpu_warn '90'
	# free RAM (%) below this is logged, 0 = off
	option mem_warn '10'
	# connection tracking table fill (%), 0 = off
	option conntrack_warn '90'

config notify 'notify'
	option enabled '0'
	# ntfy | telegram | webhook
	option service 'ntfy'
	# ntfy: topic URL (https://ntfy.sh/your-secret-topic); webhook: URL that gets a JSON POST
	option url ''
	# telegram: bot token and chat id
	option token ''
	option chat_id ''
	# err = faults only (plus recoveries), warn = also warnings
	option min_level 'err'
	# at most one message per this many seconds; events in between are batched
	option cooldown '300'
	# en | pl
	option lang 'en'

