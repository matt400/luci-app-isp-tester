
config general 'general'
	option enabled '1'
	# sampling interval in seconds
	option interval '10'
	# CSV rows kept in /tmp (8640 x 10 s = 24 h)
	option max_samples '8640'
	option max_events '1000'
	# points kept for the charts (360 x 10 s = 1 h)
	option history '360'
	# an area stays yellow this long after a warning/error event (s)
	option warn_window '900'
	# at most one "errors"/"drops" event per device per this many seconds
	option err_cooldown '60'
	# drops per interval needed to log a "drops" event
	option drop_warn '50'
	# keep timeline, history and CSV in this folder (e.g. a USB stick, /mnt/sda1)
	# instead of RAM, so they survive a reboot. Avoid the internal flash.
	option data_dir ''
	# turn messages of other services in the system log (pppd, udhcpc,
	# igmpproxy, kernel, dnsmasq) into timeline events
	option logread '1'

config wan 'wan'
	option enabled '1'
	# Ping is measured by collectd: luci-app-statistics with the Ping plugin
	# (add the ISP gateway and 1-2 far hosts) and, for live values, UnixSock.
	# logical interface used to find the WAN device and gateway
	option interface 'wan'
	# which collectd ping host is the ISP gateway; empty = gateway from netifd
	option gateway ''
	# packet loss % (per collectd interval) for yellow / red
	option loss_warn '1'
	option loss_fail '50'
	# average RTT (ms) for yellow, 0 = off
	option rtt_warn '80'
	# jitter (ms, collectd ping_stddev) for yellow, 0 = off
	option jitter_warn '0'
	# one traceroute (mtr when installed) when a loss starts, at most every
	# trace_cooldown seconds: shows at which hop the loss starts
	option trace '1'
	option trace_cooldown '600'
	# bufferbloat: ping (collectd) vs. WAN traffic of the same interval
	option bloat '1'
	option bloat_ms '30'
	option bloat_load '70'
	# IPv6: DHCPv6 session, delegated prefix and default route (router
	# advertisement) from netifd/odhcp6c; IPv6 ping = the IPv6 hosts of the
	# collectd Ping plugin. interface6 empty = wan6 or <wan>_6
	option ipv6 '1'
	option interface6 ''
	option ra_after '60'
	# optical signal of the SFP module / ONT stick the WAN goes through
	# (ethtool -m, needs the ethtool package): RX/TX power, temperature and the
	# module's alarms; a fall of the received power by sfp_drop_db below its
	# usual level (or below sfp_rx_min dBm) is logged. Shown only when the
	# module answers. sfp_device empty = the physical port of the WAN interface
	option sfp '1'
	#option sfp_device 'eth1'
	option sfp_interval '30'
	option sfp_drop_db '3'
	#option sfp_rx_min '-27'
	# speed of the plan in Mbit/s; unset = the highest rate seen
	#option down_mbit '300'
	#option up_mbit '50'

config iptv 'iptv'
	option enabled '1'
	# decoder restarts from the bridge MAC table of the IPTV VLAN (+ port link)
	option decoders '1'
	# silent this long while the stream stops = restart
	option dec_silence '40'
	# away longer = switched off, not a restart
	option dec_off '600'
	# DHCP of the decoders: the operator's replies in the IPTV VLAN (tsmon),
	# or dnsmasq-dhcp in the system log for the named decoders (routed IPTV)
	option dhcp '1'
	# IPTV VLAN number (e.g. 236). Enough when the VLAN is only bridged to the
	# decoders: bitrate from the bridge's per-VLAN counters, channels from the
	# bridge's multicast table, ports detected. Empty = use 'device' below.
	option vlan ''
	# VLAN mode: port towards the ISP; empty = detected (e.g. eth1)
	option upstream ''
	# without vlan: device that carries ONLY IPTV traffic, e.g. eth1.236 or the
	# decoder's port
	option device ''
	# rx = traffic arriving on the device, tx = traffic leaving it (decoder port)
	option direction 'rx'
	# optional bridge to show IGMP snooping/querier state of
	option bridge ''
	# below this the stream is considered stopped
	option min_kbps '500'
	# IPTV bitrate is sampled on its own timer this often (s); 0 = only once per
	# main interval (short freezes are then averaged away)
	option sample_interval '1'
	# bitrate must stay below min_kbps this long (s) to log a freeze
	option stall_after '2'
	# a stall longer than this is treated as "stream ended" (decoder off)
	option idle_after '60'
	# a stop while no channel is subscribed (IGMP) for this long (s) is logged as
	# "decoder switched off" (info), not as a fault; 0 = always a fault
	option off_after '15'
	# warn when bitrate falls below this % of its running average, 0 = off
	option dip_pct '40'
	# watch IGMP group membership and the multicast proxy (igmpproxy, mcproxy)
	option igmp '1'
	# note the operator's IGMP general queries on the IPTV VLAN (time since the
	# last one, silence = memberships expire). Needs isp-tester-tsmon and the
	# measurement of incoming traffic
	option igmp_query '1'
	# interface the proxy joins the groups on (its upstream); empty = the IPTV
	# device when measuring incoming traffic
	option igmp_device ''
	# picture quality: count lost packets (MPEG-TS continuity errors) of the
	# channel being watched, continuously, every packet. Needs the package
	# isp-tester-tsmon. The channel is found automatically.
	option quality '0'
	# lost-packet gaps within one minute for a warning / a fault
	option q_warn '1'
	option q_fail '30'
	# also warn when the stream pauses this long (ms), 0 = off
	option q_gap '500'
	# channel names: read from the streams themselves (DVB SDT table) by the
	# same helper (isp-tester-tsmon). Names can also be set by hand in
	# 'channel' sections, which win over the stream.
	option names '1'

# router load, read from /proc only to explain problems (for graphs use
# Status -> Realtime Graphs or luci-app-statistics)
config system 'system'
	option enabled '1'
	# busiest CPU core (%) for two intervals in a row = router overloaded, 0 = off
	option cpu_warn '90'
	# free RAM (%) below this is logged, 0 = off
	option mem_warn '10'
	# connection tracking table fill (%), 0 = off
	option conntrack_warn '90'

# a name for a decoder (MAC address as seen in the bridge MAC table)
#config decoder
#	option mac 'aa:bb:cc:dd:ee:01'
#	option label 'Living room'

# two routers, one timeline: a second router (e.g. an access point with a
# decoder behind it) sends its events to the main router over UDP, signed
# with the shared key (HMAC-SHA256)
config peer 'peer'
	# off | send (second router) | receive (main router)
	option role 'off'
	# send: IPv4 address of the main router
	option host ''
	option port '51477'
	# the same secret on both routers, at least 8 characters
	option key ''

# the data (timeline, history, CSV) sent to another device over SSH with
# dropbear's dbclient; the public key to add to authorized_keys there is
# shown in the settings. The other device keeps the files.
config push 'push'
	option enabled '0'
	option host ''
	option port '22'
	option user ''
	# folder on the other device (relative = in the user's home)
	option dir 'isp-tester'
	# send every this many hours
	option interval_h '24'
	# private key (made on the first use); empty = /etc/dropbear/isp_tester_push_key
	option key ''

config notify 'notify'
	option enabled '0'
	# ntfy | telegram | webhook
	option service 'ntfy'
	# ntfy: topic URL (https://ntfy.sh/your-secret-topic); webhook: URL that gets a JSON POST
	option url ''
	# telegram: bot token and chat id
	option token ''
	option chat_id ''
	# err = faults only (plus recoveries), warn = also warnings
	option min_level 'err'
	# at most one message per this many seconds; events in between are batched
	option cooldown '300'
	# auto = the language of LuCI (System -> Language) | en | pl
	option lang 'auto'

# a channel name set by hand (multicast group -> name)
#config channel
#	option group '239.1.1.1'
#	option name 'TVP 1 HD'

# ports to watch (Settings -> Ports). None by default: the names differ from
# router to router (lan1, eth0, ...), and a port that does not exist would be
# shown as a fault at once. expect_up 0 = may be unplugged (link down = info)
#config port
#	option device 'lan1'
#	option label 'Switch'
#	option expect_up '1'

# DNS of the router, from dnsmasq: ubus metrics every interval and, every
# 'dump' seconds (0 = off), its per-server statistics (SIGUSR1 -> system log)
config dns 'dns'
	option enabled '1'
	# unanswered (or per server: retried + failed) share for a warning
	option warn_pct '10'
	option min_queries '5'
	option dump '300'
