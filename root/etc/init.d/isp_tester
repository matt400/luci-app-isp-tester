#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/share/isp-tester/collector.uc
DATA=/tmp/isp-tester

# Timeline, history and CSV live in $DATA. With "data_dir" set to a mounted
# folder (USB stick), $DATA becomes a link to it, so the system keeps the data
# across reboots; nothing is copied around by the collector itself.
setup_data_dir() {
	local dir
	config_get dir general data_dir

	case "$dir" in
		/tmp|/tmp/*|/var|/var/*|*..*) dir= ;;
	esac

	if [ -n "$dir" ] && [ -d "$dir" ] && mkdir -p "$dir/isp-tester" 2>/dev/null; then
		[ "$(readlink "$DATA")" = "$dir/isp-tester" ] && return 0
		if [ -d "$DATA" ] && [ ! -L "$DATA" ]; then
			# keep what was collected in RAM so far; when it cannot be copied
			# (stick full or read-only) it is not deleted: stay in RAM
			if cp -a "$DATA/." "$dir/isp-tester/" 2>/dev/null; then
				rm -rf "$DATA"
			else
				logger -t isp-tester "cannot copy the data to $dir/isp-tester, keeping data in RAM"
				return 0
			fi
		fi
		rm -f "$DATA"
		ln -s "$dir/isp-tester" "$DATA"
	else
		# not set, or the stick is not mounted (yet): RAM
		[ -n "$dir" ] && logger -t isp-tester "data_dir $dir is not available, keeping data in RAM"
		[ -L "$DATA" ] && rm -f "$DATA"
		mkdir -p "$DATA"
	fi
}

start_service() {
	config_load isp_tester
	local enabled
	config_get_bool enabled general enabled 1
	[ "$enabled" = 1 ] || return 0

	setup_data_dir

	# watchdog: the collector reports every interval (ubus service watchdog);
	# when it stops - hung in a command, stuck - procd kills and restarts it
	local interval wd
	config_get interval general interval 10
	# a value like "10s" or "1.5" would stop the arithmetic (and the start)
	case "$interval" in ''|*[!0-9]*) interval=10 ;; esac
	wd=$(( interval * 6 ))
	[ "$wd" -lt 60 ] && wd=60

	procd_open_instance
	procd_set_param command /usr/bin/ucode "$PROG"
	procd_set_param env ISP_TESTER_WATCHDOG="$wd"
	procd_set_param pidfile /var/run/isp_tester.pid
	# restarted after a crash, without giving up (5 s apart)
	procd_set_param respawn 3600 5 0
	procd_set_param watchdog 1 "$wd"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# a clean stop (also on reload): the next start does not call the gap a crash
stop_service() {
	mkdir -p /var/run/isp-tester
	date +%s > /var/run/isp-tester/stopped
}

service_triggers() {
	procd_add_reload_trigger isp_tester
}

reload_service() {
	stop
	start
}
