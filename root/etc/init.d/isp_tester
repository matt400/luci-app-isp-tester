#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/share/isp-tester/collector.uc

start_service() {
	config_load isp_tester
	local enabled
	config_get_bool enabled general enabled 1
	[ "$enabled" = 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/bin/ucode "$PROG"
	procd_set_param pidfile /var/run/isp_tester.pid
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger isp_tester
}

reload_service() {
	stop
	start
}
