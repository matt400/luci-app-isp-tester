msgstr "Odrzucone"

msgid "Err"
msgstr "Bł."

msgid "Errors"
msgstr "Błędy"

msgid "Line"
msgstr "Linia"

msgid "Links up"
msgstr "Łącza aktywne"

msgid "Logging in to the other device…"
msgstr "Logowanie na drugie urządzenie…"

