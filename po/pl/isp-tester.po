msgstr "Utrata pakietów"

msgid "Ping (ms) – red/yellow background = packet loss"
msgstr "Ping (ms) – czerwone/żółte tło = utrata pakietów"

msgid "Stream stopped for %s"
msgstr "Strumień stał przez %s"

msgid "IPTV bitrate"
msgstr "Bitrate IPTV"

msgid "IPTV bitrate (1 min average)"
msgstr "Bitrate IPTV (średnia 1 min)"

msgid "IPTV bitrate (Mbit/s) – red = stream stopped while watching"
msgstr "Bitrate IPTV (Mbit/s) – czerwone = strumień stanął podczas oglądania"

